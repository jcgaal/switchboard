{
  "name": "switchboard",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch --env-file-if-exists=.env src/server.ts\" \"vite\"",
    "build": "vite build && node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "scrub": "bash scripts/scrub-check.sh",
    "mcp": "tsx tools/mcp-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "express": "5.2.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "twilio": "6.2.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "^9.2.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "2.3.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "lucide-react": "0.545.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "thread-stream": "3.1.0",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wouter": "3.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
