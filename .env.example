# Server
PORT=8080
LOG_LEVEL=info

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Models: provider:model-id. Providers are anthropic, openai,
# openai-compatible and gemini. FAST_MODEL is optional and turns
# on display-only transcript cleanup.
MODEL=anthropic:claude-sonnet-5-5
FAST_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama, vLLM, OpenRouter, Groq, Together and similar servers
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Local development only. Never set this on a public deployment.
SKIP_TWILIO_SIGNATURE=false

# Agent
AGENTS_DIR=./agents
AGENT=intake
# Optional first language per dialed number, e.g. {"+15550100":"en-US"}
NUMBER_LANGUAGES=

# Dashboard. PUBLIC_NUMBERS lists the lines shown at the top, e.g.
# [{"label":"United States","number":"+15550100"}]. Empty hides them.
PUBLIC_NUMBERS=
REPO_URL=https://github.com/jcgaal/switchboard
# OBSERVER_TOKEN guards the dashboard, /events and /api/status.
# Without it they stay closed unless OBSERVER_PUBLIC=true.
OBSERVER_TOKEN=
OBSERVER_PUBLIC=false
# Without CONTROL_TOKEN the voice picker is read-only,
# unless PUBLIC_VOICE_PICKER=true lets anyone change it.
CONTROL_TOKEN=
PUBLIC_VOICE_PICKER=false
SHOW_CALLER_NUMBERS=false
# Events kept in memory for observers that connect late. 0 is off.
EVENT_REPLAY=0
# Calls allowed at once. Extra callers get a busy signal. 0 is no cap.
MAX_CONCURRENT_CALLS=10
